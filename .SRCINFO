pkgbase = feagle
	pkgdesc = Local semantic file search for Arch Linux + Wayland, fully offline
	pkgver = 0.5.0
	pkgrel = 1
	url = https://github.com/microwavedKing/feagle
	install = feagle.install
	arch = any
	license = MIT
	makedepends = python-build
	makedepends = python-installer
	makedepends = python-hatchling
	makedepends = python-pytest
	depends = python
	depends = python-watchfiles
	depends = python-httpx
	depends = python-snowballstemmer
	depends = python-sqlite-vec
	optdepends = poppler: PDF indexing (pdftotext) and PDF page previews
	optdepends = quickshell: the recommended QML launcher popup (AUR)
	optdepends = llama.cpp-git: semantic search (AUR; needs a build newer than 2026-10-06)
	optdepends = llama.cpp-vulkan-git: semantic search with Vulkan offload (AUR)
	optdepends = llama.cpp-cuda-git: semantic search with CUDA offload (AUR)
	optdepends = tesseract: OCR for scanned PDFs and images
	optdepends = tesseract-data-eng: English OCR data
	optdepends = tesseract-data-rus: Russian OCR data
	optdepends = tesseract-data-osd: orientation detection for OCR ([index].ocr_osd)
	optdepends = ffmpeg: image and video indexing (downscales images, extracts frames)
	optdepends = whisper.cpp: audio transcription (AUR; provides whisper-cli)
	optdepends = fuzzel: alternative dmenu launcher for "feagle pick"
	optdepends = wofi: alternative dmenu launcher for "feagle pick"
	optdepends = rofi: alternative dmenu launcher for "feagle pick" (Wayland support since 2.0)
	optdepends = tofi: alternative dmenu launcher for "feagle pick" (AUR)
	optdepends = walker: alternative dmenu launcher for "feagle pick" (AUR)
	source = feagle-0.5.0.tar.gz::https://github.com/microwavedKing/feagle/archive/refs/tags/v0.5.0.tar.gz
