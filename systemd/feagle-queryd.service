[Unit]
Description=feagle query daemon (full-text and semantic search on a unix socket)
Documentation=https://github.com/microwavedKing/feagle
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/feagle queryd
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# RuntimeDirectory is deliberately not set: the shared runtime directory is
# managed by feagle (see the comment in feagle-indexerd.service).

[Install]
WantedBy=default.target
